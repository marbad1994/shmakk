# ── Access ───────────────────────────────────────────────────────────────────
# The password for the web UI. Anyone who has it can run commands in the
# container, so make it long and random:   openssl rand -base64 32
SHMAKK_WEB_TOKEN=

# Where the app is reached (comma-separated). Used for the cross-origin check
# and for the sign-in link printed in the logs.
SHMAKK_PUBLIC_URL=https://sh.makketing.com,http://sh.makketing.com:1029
# Address the browser pane's preview proxy (port 1087) is reachable at from
# your browser. Leave empty to use this host on port 1087.
SHMAKK_PREVIEW_URL=

# Interface the Caddy proxy publishes port 1029 on. 127.0.0.1 keeps it private
# to this machine (for a host-level proxy/tunnel); 0.0.0.0 opens it to the network.
SHMAKK_BIND=127.0.0.1

# Set to 1 when a reverse proxy (nginx, Caddy, Traefik…) sits in front, so
# X-Forwarded-* headers are honoured. The bundled Caddy proxy counts, so leave this at 1.
SHMAKK_TRUST_PROXY=1

# ── Model provider (OpenAI-compatible) ───────────────────────────────────────
SHMAKK_BASE_URL=https://your-provider.example/v1
SHMAKK_API_KEY=
SHMAKK_MODEL=gpt-4o-mini

# ── GitHub (optional — can also be connected from the UI) ────────────────────
# A personal access token with the `repo` scope, or a fine-grained token with
# Contents + Pull requests read/write.
# SHMAKK_GITHUB_TOKEN=
# To offer "Sign in with GitHub" (device flow), create an OAuth app with
# device flow enabled and put its client id here:
# SHMAKK_GITHUB_CLIENT_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
# Serve HTTPS directly from the container instead of using a reverse proxy
# (mount the files and point at them):
# SHMAKK_TLS_CERT=/data/tls/fullchain.pem
# SHMAKK_TLS_KEY=/data/tls/privkey.pem
# SHMAKK_MEM_LIMIT=4g
